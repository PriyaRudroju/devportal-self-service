{
  "identifier": "trigger_github_on_ec2_approved",
  "title": "Trigger GitHub When EC2 Approved (Legacy)",
  "description": "Legacy automation — prefer Port Workflow provision_ec2_after_approval",
  "trigger": {
    "type": "automation",
    "event": {
      "type": "ENTITY_UPDATED",
      "blueprintIdentifier": "ec2ChangeRequest"
    },
    "condition": {
      "type": "JQ",
      "expressions": [
        ".diff.before.properties.approvalStatus == \"pending\"",
        ".diff.after.properties.approvalStatus == \"approved\""
      ],
      "combinator": "and"
    }
  },
  "invocationMethod": {
    "type": "INTEGRATION_ACTION",
    "installationId": "{{GITHUB_INSTALLATION_ID}}",
    "integrationActionType": "dispatch_workflow",
    "integrationActionExecutionProperties": {
      "org": "{{GITHUB_ORG}}",
      "repo": "{{GITHUB_REPO}}",
      "workflow": "change-ec2-instance.yml",
      "ref": "{{ .event.diff.before.properties.gitRef }}",
      "reportWorkflowStatus": true,
      "workflowInputs": {
        "instance_name": "{{ .event.diff.after.properties.instanceName }}",
        "instance_type": "{{ .event.diff.after.properties.instanceType }}",
        "environment": "{{ .event.diff.after.properties.environment }}",
        "port_context": "{\"runId\":\"{{ .event.diff.after.properties.portRunId }}\"}",
        "requested_by": "{{ .event.diff.after.properties.requestedBy }}"
      }
    }
  },
  "publish": true
}
