{
  "identifier": "change_ec2_instance",
  "title": "Provision EC2 Instance (GitOps Demo)",
  "icon": "AWS",
  "description": "Legacy self-service action — prefer Port Workflow provision_ec2_request",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "blueprintIdentifier": "ec2ChangeRequest",
    "userInputs": {
      "properties": {
        "instance_name": {
          "title": "Instance Name",
          "type": "string",
          "description": "Name tag for the new EC2 instance"
        },
        "instance_type": {
          "title": "Instance Type",
          "type": "string",
          "enum": ["t3.micro", "t3.small", "t3.medium"],
          "default": "t3.micro"
        },
        "environment": {
          "title": "Environment",
          "type": "string",
          "enum": ["dev"],
          "default": "dev"
        }
      },
      "required": ["instance_name", "instance_type", "environment"]
    }
  },
  "invocationMethod": {
    "type": "WEBHOOK",
    "url": "{{API_GATEWAY_URL}}/ec2/request",
    "method": "POST",
    "synchronized": false,
    "body": {
      "runId": "{{ .run.id }}",
      "instance_name": "{{ .inputs.instance_name }}",
      "instance_type": "{{ .inputs.instance_type }}",
      "environment": "{{ .inputs.environment }}",
      "requested_by": "{{ .trigger.by.user.email }}",
      "port_run_url": "https://app.port.io/organization/run?runId={{ .run.id }}"
    }
  }
}
