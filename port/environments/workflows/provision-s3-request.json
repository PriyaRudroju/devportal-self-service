{
  "identifier": "provision_s3_request",
  "title": "Provision S3 Bucket",
  "icon": "Bucket",
  "description": "Request S3 bucket provisioning — creates catalog entity, marks ready, then dispatches GitHub on the form Git Branch",
  "category": "Infra",
  "nodes": [
    {
      "identifier": "trigger",
      "title": "S3 Request Form",
      "config": {
        "type": "SELF_SERVE_TRIGGER",
        "userInputs": {
          "properties": {
            "bucket_name": {
              "title": "Bucket Name",
              "type": "string",
              "description": "Globally unique S3 bucket name"
            },
            "git_ref": {
              "title": "Git Branch",
              "type": "string",
              "description": "Git branch to run provision-s3-bucket.yml on (e.g. dev or feature/my-test). Defaults to {{GIT_REF_DEFAULT}}. A branch that is not present in Git fails at Trigger GitHub.",
              "default": "{{GIT_REF_DEFAULT}}"
            }
          },
          "required": ["bucket_name", "git_ref"]
        }
      }
    },
    {
      "identifier": "create_pending_entity",
      "title": "Create Pending Catalog Entity",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "s3Bucket",
        "mapping": {
          "identifier": "{{ .workflowRun.identifier }}",
          "title": "S3 {{ .outputs.trigger.bucket_name }}",
          "properties": {
            "bucketName": "{{ .outputs.trigger.bucket_name }}",
            "gitRef": "{{ .outputs.trigger.git_ref }}",
            "environment": "dev",
            "region": "{{AWS_REGION}}",
            "status": "pending",
            "requestedBy": "{{ .workflowRun.trigger.by.email }}",
            "portRunId": "{{ .workflowRun.identifier }}"
          }
        }
      }
    },
    {
      "identifier": "mark_ready_entity",
      "title": "Mark Catalog Entity Ready (Lambda)",
      "config": {
        "type": "WEBHOOK",
        "url": "{{API_GATEWAY_URL}}/s3/mark-ready",
        "method": "POST",
        "synchronized": true,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "entityId": "{{ .workflowRun.identifier }}"
        }
      }
    },
    {
      "identifier": "dispatch_github",
      "title": "Trigger GitHub",
      "config": {
        "type": "WEBHOOK",
        "url": "https://api.github.com/repos/{{GITHUB_ORG}}/{{GITHUB_REPO}}/actions/workflows/provision-s3-bucket.yml/dispatches",
        "method": "POST",
        "synchronized": true,
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28",
          "Content-Type": "application/json",
          "Authorization": "Bearer {{ .secrets[\"GITHUB_DISPATCH_TOKEN\"] }}"
        },
        "body": {
          "ref": "{{ .outputs.trigger.git_ref }}",
          "inputs": {
            "bucket_name": "{{ .outputs.trigger.bucket_name }}",
            "environment": "dev",
            "port_run_id": "{{ .workflowRun.identifier }}"
          }
        }
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "create_pending_entity"
    },
    {
      "sourceIdentifier": "create_pending_entity",
      "targetIdentifier": "mark_ready_entity"
    },
    {
      "sourceIdentifier": "mark_ready_entity",
      "targetIdentifier": "dispatch_github"
    }
  ]
}
