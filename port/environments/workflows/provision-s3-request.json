{
  "identifier": "provision_s3_request",
  "title": "Provision S3 Bucket",
  "icon": "Bucket",
  "description": "Request S3 bucket provisioning — creates catalog entity; GitHub dispatch runs via automation (legacy Sunset app)",
  "category": "Infra",
  "nodes": [
    {
      "identifier": "trigger",
      "title": "S3 Request Form",
      "config": {
        "type": "SELF_SERVE_TRIGGER",
        "userInputs": {
          "properties": {
            "bucket_name": {
              "title": "Bucket Name",
              "type": "string",
              "description": "Globally unique S3 bucket name"
            },
            "git_ref": {
              "title": "Git Branch",
              "type": "string",
              "description": "Git branch to run provision-s3-bucket.yml on (e.g. dev or feature/my-test). Leave empty to use dev. Invalid branches fail validation before GitHub is triggered.",
              "default": "{{GIT_REF_DEFAULT}}"
            }
          },
          "required": ["bucket_name"]
        }
      }
    },
    {
      "identifier": "create_pending_entity",
      "title": "Create Pending Catalog Entity",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "s3Bucket",
        "mapping": {
          "identifier": "{{ .workflowRun.identifier }}",
          "title": "S3 {{ .outputs.trigger.bucket_name }}",
          "properties": {
            "bucketName": "{{ .outputs.trigger.bucket_name }}",
            "gitRef": "{{ .outputs.trigger.git_ref }}",
            "environment": "dev",
            "region": "{{AWS_REGION}}",
            "status": "pending",
            "requestedBy": "{{ .workflowRun.trigger.by.email }}",
            "portRunId": "{{ .workflowRun.identifier }}"
          }
        }
      }
    },
    {
      "identifier": "validate_git_ref",
      "title": "Validate Git Branch (Lambda)",
      "config": {
        "type": "WEBHOOK",
        "url": "{{API_GATEWAY_URL}}/s3/validate-git-ref",
        "method": "POST",
        "synchronized": true,
        "body": {
          "entityId": "{{ .workflowRun.identifier }}"
        }
      }
    },
    {
      "identifier": "mark_ready_entity",
      "title": "Mark Catalog Entity Ready (Lambda)",
      "config": {
        "type": "WEBHOOK",
        "url": "{{API_GATEWAY_URL}}/s3/mark-ready",
        "method": "POST",
        "synchronized": true,
        "body": {
          "entityId": "{{ .workflowRun.identifier }}"
        }
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "create_pending_entity"
    },
    {
      "sourceIdentifier": "create_pending_entity",
      "targetIdentifier": "validate_git_ref"
    },
    {
      "sourceIdentifier": "validate_git_ref",
      "targetIdentifier": "mark_ready_entity"
    }
  ]
}
