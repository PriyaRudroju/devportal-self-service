{
  "identifier": "provision_s3_request",
  "title": "Provision S3 Bucket",
  "icon": "Bucket",
  "description": "Request S3 bucket provisioning — form, catalog entity, then GitHub workflow dispatch (no Teams approval)",
  "category": "Infra",
  "nodes": [
    {
      "identifier": "trigger",
      "title": "S3 Request Form",
      "config": {
        "type": "SELF_SERVE_TRIGGER",
        "userInputs": {
          "properties": {
            "bucket_name": {
              "title": "Bucket Name",
              "type": "string",
              "description": "Globally unique S3 bucket name"
            },
            "environment": {
              "title": "Environment",
              "type": "string",
              "description": "Git branch to run the workflow from (dev playground). Add feature branch names to enum when testing.",
              "enum": ["dev"],
              "default": "dev"
            }
          },
          "required": ["bucket_name", "environment"]
        }
      }
    },
    {
      "identifier": "create_ready_entity",
      "title": "Create Ready Catalog Entity",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "s3Bucket",
        "mapping": {
          "identifier": "{{ .run.id }}",
          "title": "S3 {{ .outputs.trigger.bucket_name }}",
          "properties": {
            "bucketName": "{{ .outputs.trigger.bucket_name }}",
            "gitRef": "{{ .outputs.trigger.environment }}",
            "environment": "dev",
            "region": "{{AWS_REGION}}",
            "status": "ready",
            "requestedBy": "{{ .trigger.by.user.email }}",
            "portRunId": "{{ .run.id }}"
          }
        }
      }
    },
    {
      "identifier": "dispatch_github",
      "title": "Trigger GitHub S3 Workflow",
      "config": {
        "type": "INTEGRATION_ACTION",
        "installationId": "{{GITHUB_INSTALLATION_ID}}",
        "integrationActionType": "dispatch_workflow",
        "integrationActionExecutionProperties": {
          "org": "{{GITHUB_ORG}}",
          "repo": "{{GITHUB_REPO}}",
          "workflow": "provision-s3-bucket.yml",
          "reportWorkflowStatus": true,
          "workflowInputs": {
            "ref": "{{ .outputs.trigger.environment }}",
            "bucket_name": "{{ .outputs.trigger.bucket_name }}",
            "environment": "dev",
            "port_run_id": "{{ .run.id }}"
          }
        }
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "create_ready_entity"
    },
    {
      "sourceIdentifier": "create_ready_entity",
      "targetIdentifier": "dispatch_github"
    }
  ]
}
