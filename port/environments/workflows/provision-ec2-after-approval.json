{
  "identifier": "provision_ec2_after_approval",
  "title": "Provision EC2 After Teams Approval",
  "icon": "AWS",
  "description": "Triggers GitHub provisioning when catalog entity moves pending to approved",
  "category": "Infra",
  "nodes": [
    {
      "identifier": "trigger",
      "title": "On EC2 Approved",
      "config": {
        "type": "EVENT_TRIGGER",
        "event": {
          "type": "ENTITY_UPDATED",
          "blueprintIdentifier": "ec2ChangeRequest"
        },
        "condition": {
          "type": "JQ",
          "expressions": [
            ".diff.before.properties.approvalStatus == \"pending\"",
            ".diff.after.properties.approvalStatus == \"approved\""
          ],
          "combinator": "and"
        }
      }
    },
    {
      "identifier": "dispatch_github",
      "title": "Trigger GitHub EC2 Workflow",
      "config": {
        "type": "INTEGRATION_ACTION",
        "installationId": "{{GITHUB_INSTALLATION_ID}}",
        "integrationProvider": "github-ocean",
        "integrationInvocationType": "dispatch_workflow",
        "integrationActionExecutionProperties": {
          "org": "{{GITHUB_ORG}}",
          "repo": "{{GITHUB_REPO}}",
          "workflow": "change-ec2-instance.yml",
          "reportWorkflowStatus": true,
          "workflowInputs": {
            "ref": "{{GITHUB_WORKFLOW_REF}}",
            "instance_name": "{{ .outputs.trigger.diff.after.properties.instanceName }}",
            "instance_type": "{{ .outputs.trigger.diff.after.properties.instanceType }}",
            "environment": "{{ .outputs.trigger.diff.after.properties.environment }}",
            "port_context": "{\"runId\":\"{{ .outputs.trigger.diff.after.properties.portRunId }}\"}",
            "requested_by": "{{ .outputs.trigger.diff.after.properties.requestedBy }}"
          }
        }
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "dispatch_github"
    }
  ]
}
