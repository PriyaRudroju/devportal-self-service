{
  "identifier": "change_ec2_instance",
  "title": "Provision EC2 Instance",
  "icon": "AWS",
  "description": "Provision an EC2 instance with Teams approval before execution",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "blueprintIdentifier": "ec2ChangeRequest",
    "userInputs": {
      "properties": {
        "instance_name": {
          "title": "Instance Name",
          "type": "string",
          "description": "Name tag for the new EC2 instance"
        },
        "instance_type": {
          "title": "Instance Type",
          "type": "string",
          "enum": ["t3.micro", "t3.small", "t3.medium"],
          "default": "t3.micro"
        },
        "environment": {
          "title": "Environment",
          "type": "string",
          "enum": ["dev"],
          "default": "dev"
        }
      },
      "required": ["instance_name", "instance_type", "environment"]
    }
  },
  "requiredApproval": true,
  "invocationMethod": {
    "type": "GITHUB",
    "org": "PriyaRudroju",
    "repo": "devportal-self-service",
    "workflow": "change-ec2-instance.yml",
    "reportWorkflowStatus": true,
    "workflowInputs": {
      "instance_name": "{{ .inputs.instance_name }}",
      "instance_type": "{{ .inputs.instance_type }}",
      "environment": "{{ .inputs.environment }}",
      "port_context": "{\"runId\":\"{{ .run.id }}\"}",
      "requested_by": "{{ .trigger.by.user.email }}"
    }
  }
}
