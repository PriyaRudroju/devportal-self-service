# Copy to secrets.auto.tfvars (same folder), fill in values, save.
# secrets.auto.tfvars is gitignored — do not commit real secrets.
#
# teams_webhook_url = "https://prod-xx.logic.azure.com/workflows/..."
# port_client_id     = "your-port-client-id"
# port_client_secret = "your-port-client-secret"
# aws_region         = "us-east-2"

teams_webhook_url = "PASTE_TEAMS_WEBHOOK"
port_client_id     = "PASTE_PORT_CLIENT_ID"
port_client_secret = "PASTE_PORT_CLIENT_SECRET"
aws_region         = "us-east-2"
